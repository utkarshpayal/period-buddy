{
  "expo": {
    "name": "The Nura",
    "slug": "thenuracare",
    "version": "1.1.7",
    "orientation": "portrait",
    "icon": "./assets/images/brand/app-icon.png",
    "splash": {
      "image": "./assets/images/brand/logo-full.png",
      "resizeMode": "contain",
      "backgroundColor": "#FBF6F8"
    },
    "scheme": [
      "thenura",
      "com.uvin124.thenura"
    ],
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#FBF6F8",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.uvin124.thenura",
      "googleServicesFile": "./assets/GoogleService-Info.plist",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "The Nura uses your camera for video calls and to photograph documents you choose to upload.",
        "NSMicrophoneUsageDescription": "The Nura uses your microphone for voice questions to Nura AI, voice notes and video calls.",
        "NSFaceIDUsageDescription": "The Nura uses Face ID to unlock the app and keep your data private.",
        "LSApplicationQueriesSchemes": ["upi", "tez", "gpay", "phonepe", "paytmmp", "credpay", "bhim"]
      },
      "associatedDomains": [
        "applinks:thenura.care"
      ]
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/images/brand/adaptive-foreground.png",
        "monochromeImage": "./assets/images/brand/adaptive-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.uvin124.thenura",
      "googleServicesFile": "./assets/google-services.json",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.VIBRATE"
      ],
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "thenura.care",
              "pathPrefix": "/app"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/brand/app-icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-font",
        {
          "android": {
            "fonts": [
              {
                "fontFamily": "Manrope",
                "fontDefinitions": [
                  {
                    "path": "./assets/fonts/Manrope_300Light.ttf",
                    "weight": 300
                  },
                  {
                    "path": "./assets/fonts/Manrope_400Regular.ttf",
                    "weight": 400
                  },
                  {
                    "path": "./assets/fonts/Manrope_500Medium.ttf",
                    "weight": 500
                  },
                  {
                    "path": "./assets/fonts/Manrope_600SemiBold.ttf",
                    "weight": 600
                  },
                  {
                    "path": "./assets/fonts/Manrope_700Bold.ttf",
                    "weight": 700
                  },
                  {
                    "path": "./assets/fonts/Manrope_800ExtraBold.ttf",
                    "weight": 800
                  }
                ]
              }
            ]
          },
          "ios": {
            "fonts": [
              "./assets/fonts/Manrope_300Light.ttf",
              "./assets/fonts/Manrope_400Regular.ttf",
              "./assets/fonts/Manrope_500Medium.ttf",
              "./assets/fonts/Manrope_600SemiBold.ttf",
              "./assets/fonts/Manrope_700Bold.ttf",
              "./assets/fonts/Manrope_800ExtraBold.ttf"
            ]
          }
        }
      ],
      "expo-asset",
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "buildArchs": [
              "armeabi-v7a",
              "arm64-v8a"
            ]
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/brand/notification-icon.png",
          "color": "#E8618F",
          "sounds": [
            "./assets/sounds/notification.wav"
          ]
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow The Nura to choose your profile picture."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/brand/logo-full.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FBF6F8"
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow The Nura to use Face ID to unlock the app."
        }
      ],
      "expo-video",
      [
        "expo-audio",
        {
          "microphonePermission": "The Nura uses your microphone for voice questions to Nura AI, voice notes and video calls."
        }
      ],
      "./plugins/withUpiAppQueries"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "apiBaseUrls": {
        "prod": "https://www.backend.thenura.care",
        "stage": "https://stage.backend.thenura.care"
      },
      "googleClientIds": {
        "web": "729251216529-95q69sjt3nh6tl6m0ak0ieoq8dbtjuqr.apps.googleusercontent.com",
        "ios": "729251216529-k8ej20e55d5onqv028lt132k62ms76rd.apps.googleusercontent.com",
        "android": "729251216529-uckp51hhjo159m3pt4jbrfinap5s3trn.apps.googleusercontent.com",
        "expo": "729251216529-qe8sbs3mcgon9ne0gclqooiugc5e63hn.apps.googleusercontent.com"
      },
      "eas": {
        "projectId": "b1582d15-6e00-455c-b5d9-97d0435c04af"
      }
    },
    "owner": "utkarsh-payal"
  }
}
