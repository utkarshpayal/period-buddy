{
  "expo": {
    "name": "The Nura",
    "slug": "period-budddy",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo-adaptive.png",
    "splash": {
      "image": "./assets/images/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "scheme": "thenura",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.uvin124.thenura",
      "googleServicesFile": "./assets/GoogleService-Info.plist",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "The Nura uses your camera for video calls with your Period Buddy.",
        "NSMicrophoneUsageDescription": "The Nura uses your microphone for video calls with your Period Buddy.",
        "NSFaceIDUsageDescription": "The Nura uses Face ID to unlock the app and keep your data private."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#fff0f6",
        "foregroundImage": "./assets/images/logo-adaptive.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.uvin124.thenura",
      "googleServicesFile": "./assets/google-services.json",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/logo-withoutbg.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "buildArchs": [
              "arm64-v8a"
            ]
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/logo.png",
          "color": "#fff0f6",
          "sounds": [
            "./lib/notification.wav"
          ]
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow The Nura to choose your profile picture.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/logo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow The Nura to use Face ID to unlock the app."
        }
      ],
      "expo-video",
      "expo-audio"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "7201c23c-92e0-4c94-8ea9-a7af36d312d8"
      }
    },
    "owner": "uvin124"
  }
}
