{
  "expo": {
    "name": "The Nura",
    "slug": "thenuracare",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/brand/app-icon.png",
    "splash": {
      "image": "./assets/images/brand/logo-full.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "scheme": [
      "thenura",
      "com.uvin124.thenura"
    ],
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.uvin124.thenura",
      "googleServicesFile": "./assets/GoogleService-Info.plist",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "The Nura uses your camera for video calls and to photograph documents you choose to upload.",
        "NSMicrophoneUsageDescription": "The Nura uses your microphone for voice questions to Nura AI, voice notes and video calls.",
        "NSFaceIDUsageDescription": "The Nura uses Face ID to unlock the app and keep your data private."
      },
      "associatedDomains": [
        "applinks:thenura.care"
      ]
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#fff0f6",
        "foregroundImage": "./assets/images/brand/app-icon.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.uvin124.thenura",
      "googleServicesFile": "./assets/google-services.json",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ],
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "thenura.care",
              "pathPrefix": "/app"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/brand/app-icon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-asset",
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "buildArchs": [
              "arm64-v8a"
            ]
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/brand/app-icon.png",
          "color": "#fff0f6",
          "sounds": [
            "./assets/sounds/notification.wav"
          ]
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow The Nura to choose your profile picture."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/brand/logo-full.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow The Nura to use Face ID to unlock the app."
        }
      ],
      "expo-video",
      [
        "expo-audio",
        {
          "microphonePermission": "The Nura uses your microphone for voice questions to Nura AI, voice notes and video calls."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b1582d15-6e00-455c-b5d9-97d0435c04af"
      }
    },
    "owner": "utkarsh-payal"
  }
}
