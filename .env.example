# Backend toggle: stage | prod
EXPO_PUBLIC_APP_ENV=prod
# Optional: overrides the toggle with any URL (e.g. a local backend)
# EXPO_PUBLIC_API_BASE_URL=http://<your LAN IP>:5001

# Google Sign-In — public OAuth 2.0 client IDs (same values as eas.json), from
# https://console.cloud.google.com/apis/credentials. Only fill in the ones
# for the platforms you build for; the backend must have the matching
# GOOGLE_*_CLIENT_ID values set so it can verify tokens from these clients.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=729251216529-95q69sjt3nh6tl6m0ak0ieoq8dbtjuqr.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=729251216529-k8ej20e55d5onqv028lt132k62ms76rd.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=729251216529-uckp51hhjo159m3pt4jbrfinap5s3trn.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_EXPO_CLIENT_ID=729251216529-qe8sbs3mcgon9ne0gclqooiugc5e63hn.apps.googleusercontent.com
