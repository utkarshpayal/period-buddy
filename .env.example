EXPO_PUBLIC_API_BASE_URL=https://period-buddy-be.onrender.com

# Google Sign-In — OAuth 2.0 client IDs from
# https://console.cloud.google.com/apis/credentials. Only fill in the ones
# for the platforms you build for; the backend must have the matching
# GOOGLE_*_CLIENT_ID values set so it can verify tokens from these clients.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_EXPO_CLIENT_ID=

# Razorpay — key id only (public, safe to ship in the app). Must match the
# backend's RAZORPAY_KEY_ID. Get it at https://dashboard.razorpay.com/app/keys.
EXPO_PUBLIC_RAZORPAY_KEY_ID=
