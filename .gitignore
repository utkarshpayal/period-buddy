# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts
.vscode/
# Personal Claude Code settings (the shared .claude/settings.json and hooks are tracked)
.claude/settings.local.json
# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# env files — every variant holds real values; only the example is tracked
.env
.env.*
!.env.example
# typescript
*.tsbuildinfo


# build outputs (`eas build --local` drops build-<timestamp>.apk/.aab in the root)
build/
build-*.apk
build-*.aab
build-*.ipa
*.apk
*.aab
*.ipa

# generated native folders
/ios
/android

# EAS local credentials (secrets)
credentials.json
/credentials/

# Firebase client config (assets/google-services.json, GoogleService-Info.plist)
# is tracked on purpose: app.json points EAS builds at it, and these client
# keys ship inside every app binary anyway (restricted by package/bundle id).
