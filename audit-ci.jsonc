// Dependency audit for CI (.github/workflows/security.yml): fails on any high
// or critical advisory in production dependencies, except the ones below.
// Each was reviewed; remove an entry once a fix can be installed.
{
  "$schema": "https://github.com/IBM/audit-ci/raw/main/docs/schema.json",
  "high": true,
  "skip-dev": true,
  "allowlist": [
    // image-size (via Expo's Metro bundler): only reads our own bundled
    // images at build time. Fixed only in image-size 2.x, whose API Metro
    // doesn't use; goes away with an Expo SDK upgrade.
    "GHSA-5p2g-fcmc-qvqq",
    "GHSA-w3rx-r6r6-pgpr",
    // linkify-it (via markdown-it 10, via react-native-markdown-display 7):
    // slow-rendering (DoS) bugs. The app only renders
    // blog posts from the Content Studio and AI answers to the person's own
    // question, never text written by other users. Replace the markdown
    // library to clear these.
    "GHSA-22p9-wv53-3rq4",
    "GHSA-v245-v573-v5vm",
    // markdown-it 10 itself (same path): quadratic-time smartquotes parsing.
    // Same reasoning: only Content Studio text and AI answers to the
    // person's own question are rendered. Fixed in markdown-it 14, which
    // react-native-markdown-display 7 doesn't support.
    "GHSA-r7fv-28h4-cvq7",
    // decode-uri-component 0.2 (via query-string 7, via expo-router): slow
    // (quadratic) decoding of a crafted, very long percent-encoded string.
    // expo-router decodes our own route URLs and deep links, and incoming
    // links are first matched against SHAREABLE_ROUTES (lib/deeplink.ts);
    // the worst case is a slow tap on a hand-made link, no data exposure.
    // Fixed only in 0.5.1, which is ESM-only and can't be loaded by
    // query-string 7's require(); goes away with an expo-router upgrade.
    "GHSA-qr28-fpjm-wq7f"
  ]
}
